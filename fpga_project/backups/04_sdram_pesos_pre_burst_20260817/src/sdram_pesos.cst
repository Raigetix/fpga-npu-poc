// sdram_pesos.cst -- constraints para top_sdram_p1/p2/p3.v. Mismos pines
// de SPI/LED que el resto del proyecto (top.cst). Los pines de la SDRAM
// (O_sdram_*/IO_sdram_dq) NO se constrain aca: son "nombres magicos" que
// Gowin conecta solo a los pines fisicos correctos del GW2AR-18 -- si se
// les agrega IO_LOC a mano, la sintesis va a fallar.
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;

IO_LOC "sclk" 72;
IO_PORT "sclk" IO_TYPE=LVCMOS33;

IO_LOC "cs_n" 71;
IO_PORT "cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "mosi" 79;
IO_PORT "mosi" IO_TYPE=LVCMOS33;

IO_LOC "miso" 86;
IO_PORT "miso" IO_TYPE=LVCMOS33;

IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33;
IO_PORT "led[1]" IO_TYPE=LVCMOS33;
IO_PORT "led[2]" IO_TYPE=LVCMOS33;
IO_PORT "led[3]" IO_TYPE=LVCMOS33;
IO_PORT "led[4]" IO_TYPE=LVCMOS33;
IO_PORT "led[5]" IO_TYPE=LVCMOS33;
